# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=cohort_insights

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Pipeline timing (seconds) ─────────────────────────────────
PIPELINE_STAGE1_MIN_DELAY=10
PIPELINE_STAGE1_MAX_DELAY=20
PIPELINE_STAGE2_MIN_DELAY=5
PIPELINE_STAGE2_MAX_DELAY=15

# Probability that any individual stage attempt fails (0.0–1.0)
PIPELINE_FAILURE_RATE=0.1

# Retry configuration
PIPELINE_MAX_RETRIES=2
PIPELINE_RETRY_BASE_DELAY=1.0

# ── Rate limiting ──────────────────────────────────────────────
# Max concurrent documents per user in {queued, processing, enriching}
RATE_LIMIT_MAX_CONCURRENT=3

# ── Content cache ──────────────────────────────────────────────
CACHE_TTL=3600

# ── Misc ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
